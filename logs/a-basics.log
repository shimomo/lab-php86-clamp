# A: basics
# PHP 8.6.0RC2, clamp(): native

## signature
clamp(mixed $value, mixed $min, mixed $max): mixed

## value inside, below and above the range
clamp(2, 1, 3)                               => int(2)
clamp(0, 1, 3)                               => int(1)
clamp(6, 1, 3)                               => int(3)
clamp(min: 0, value: 120, max: 90)           => int(90)

## int and float mixed
clamp(2, 1.3, 3.4)                           => int(2)
clamp(2.5, 1, 3)                             => float(2.5)
clamp(2.5, 1.3, 3.4)                         => float(2.5)
clamp(0, 1.3, 3.4)                           => float(1.3)
clamp(M_PI, -INF, INF)                       => float(3.141592653589793)

## anything comparable
clamp("a", "c", "g")                         => string(1) "c"
clamp("d", "c", "g")                         => string(1) "d"
clamp(d("2025-08-01"), d("2025-08-15"), d("2025-09-15")) => DateTimeImmutable(2025-08-15)
clamp(d("2025-08-20"), d("2025-08-15"), d("2025-09-15")) => DateTimeImmutable(2025-08-20)

## NAN and invalid bounds
clamp(NAN, 4, 6)                             => float(NAN)
clamp(4, NAN, 6)                             => ValueError: clamp(): Argument #2 ($min) must not be NAN
clamp(4, 6, NAN)                             => ValueError: clamp(): Argument #3 ($max) must not be NAN
clamp(4, 8, 6)                               => ValueError: clamp(): Argument #2 ($min) must be smaller than or equal to argument #3 ($max)
